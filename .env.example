# --- Database ---
# PostgreSQL connection string (primary, recommended for the full project)
# Example if running Postgres via docker-compose (see docker-compose.yml):
DATABASE_URL=postgresql+psycopg2://slduser:sldpassword@localhost:5432/suspicious_login_db

# Fallback for quick local testing without installing/running PostgreSQL.
# The backend uses whatever DATABASE_URL is set to; swap to the line above
# once PostgreSQL is available. SQLite is NOT used in the graded submission.
# DATABASE_URL=sqlite:///./dev_fallback.db

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-for-your-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OTP (demo mode) ---
OTP_EXPIRE_MINUTES=5
OTP_DEMO_MODE=true

# --- Risk thresholds ---
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# Context classification: replace this documentation subnet with campus CIDRs.
CAMPUS_IP_RANGES=192.0.2.0/24
# JSON mapping of lab identifiers to high-entropy device secrets.
LAB_DEVICE_TOKENS={}
# Disable demo overrides before connecting real ERP traffic.
DEMO_CONTEXT_ENABLED=true
LOGIN_TIMEZONE=Asia/Kolkata
OTP_MAX_ATTEMPTS=5
# Failed passwords older than this stop counting towards OTP or block decisions.
FAILED_ATTEMPT_WINDOW_MINUTES=15
